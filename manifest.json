      "policy": "replace",
      "areas": [
        "Town Map",
        "Fly destination picker",
        "Kanto map menu"
      ],
      "reason_en": "Voxel Ascendant 3.0 integrates the reviewed Kanto Widescreen Map 1.0.0 and retains the older compact renderer only as an internal fail-open fallback.",
      "reason_de": "Voxel Ascendant 3.0 integriert die geprüfte Kanto-Widescreen-Karte 1.0.0 und behält die ältere kompakte Darstellung nur als internen Fail-open-Fallback.",
      "resolution_en": "Keep Voxel Ascendant enabled; the launcher disables the obsolete standalone map automatically.",
      "resolution_de": "Voxel Ascendant aktiviert lassen; der Launcher deaktiviert die überholte Einzelkarten-Mod automatisch."
    },
    {
      "ids": [
        "vasc_species_fly_cinematic",
        "vasc_species_surf_cinematic",
        "vasc_species_fishing_cinematic"
      ],
      "policy": "replace",
      "areas": [
        "Generation 1 FLY presentation",
        "Generation 1 SURF presentation",
        "Generation 1 and 2 fishing presentation",
        "voxel pipeline composition",
        "field-tech controller bridges"
      ],
      "reason_en": "Voxel Ascendant 3.0 integrates the reviewed Fly 0.4.3, Surf 0.3.1 and Fishing 0.1.0 presentation runtimes while sharing one directional artwork tree; loading a retired standalone companion would duplicate controller and renderer hooks.",
      "reason_de": "Voxel Ascendant 3.0 integriert die geprüften Darstellungs-Laufzeiten aus Fly 0.4.3, Surf 0.3.1 und Fishing 0.1.0 mit einem gemeinsamen Richtungs-Grafikbaum; ein zusätzlicher alter Einzel-Mod würde Controller- und Renderer-Hooks verdoppeln.",
      "resolution_en": "Keep Voxel Ascendant enabled; the launcher disables the retired cinematic companion packages automatically.",
      "resolution_de": "Voxel Ascendant aktiviert lassen; der Launcher deaktiviert die ausgemusterten Cinematic-Einzelpakete automatisch."
    },
    {
      "ids": [
        "vasc_oras_storage_ui"
      ],
      "policy": "replace",
      "areas": [
        "Start-menu party presentation",
        "party summary and modal overlays",
        "Pokemon UI skins"
      ],
      "reason_en": "Voxel Ascendant 3.0 integrates the reviewed ORAS Storage UI 0.5.3 party, summary and overlay presentation. Loading the retired standalone package would duplicate Start-menu and screen hooks.",
      "reason_de": "Voxel Ascendant 3.0 integriert die geprüfte Team-, Bericht- und Overlay-Darstellung aus ORAS Storage UI 0.5.3. Das zusätzliche Einzelpaket würde Startmenü- und Screen-Hooks verdoppeln.",
      "resolution_en": "Keep Voxel Ascendant enabled; the launcher disables the retired standalone UI package automatically.",
      "resolution_de": "Voxel Ascendant aktiviert lassen; der Launcher deaktiviert das ausgemusterte UI-Einzelpaket automatisch."
    },
    {
      "ids": [
        "vasc_modern_pokedex"
      ],
      "policy": "replace",
      "areas": [
        "Generation 1 Pokedex list",
        "Generation 1 Pokedex entry",
        "Pokedex encounter-area shell"
      ],
      "reason_en": "Voxel Ascendant 3.0 integrates the reviewed Modern Pokedex 0.4.0 presentation and its native fail-open host; loading the standalone package would claim the same two screen ids twice.",
      "reason_de": "Voxel Ascendant 3.0 integriert die geprüfte Modern-Pokédex-Darstellung 0.4.0 samt nativem Fail-open-Host; das Einzelpaket würde dieselben beiden Screen-IDs doppelt beanspruchen.",
      "resolution_en": "Keep Voxel Ascendant enabled; the launcher disables the retired standalone Pokedex automatically.",
      "resolution_de": "Voxel Ascendant aktiviert lassen; der Launcher deaktiviert den ausgemusterten Einzel-Pokédex automatisch."
